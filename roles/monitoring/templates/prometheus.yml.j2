global:
  scrape_interval: 10s
  evaluation_interval: 10s

rule_files:
  - /etc/prometheus/rules.yml

scrape_configs:
  - job_name: patroni
    static_configs:
      - targets:
{% for h in groups['etcd_nodes'] %}
          - "{{ hostvars[h]['ansible_host'] }}:8008"
{% endfor %}
  - job_name: postgres
    static_configs:
      - targets:
{% for h in groups['etcd_nodes'] %}
          - "{{ hostvars[h]['ansible_host'] }}:9187"
{% endfor %}
  - job_name: haproxy
    static_configs:
      - targets:
{% for h in groups['balancers'] %}
          - "{{ hostvars[h]['ansible_host'] }}:8404"
{% endfor %}
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
