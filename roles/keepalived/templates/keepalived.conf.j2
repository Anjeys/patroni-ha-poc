global_defs {
  enable_script_security
  script_user root
}

# The address follows a working HAProxy, not merely a live host: a balancer
# whose proxy died loses 60 points and the other one takes over.
vrrp_script chk_haproxy {
  script "/usr/bin/systemctl is-active --quiet haproxy"
  interval 2
  weight -60
}

vrrp_instance pg_access {
  state {{ keepalived_state }}
  interface eth0
  virtual_router_id 51
  priority {{ keepalived_priority }}
  advert_int 1
  # Unicast: a bridge network is not guaranteed to pass VRRP multicast.
  unicast_src_ip {{ ansible_host }}
  unicast_peer {
{% for h in groups['balancers'] if h != inventory_hostname %}
    {{ hostvars[h]['ansible_host'] }}
{% endfor %}
  }
  virtual_ipaddress {
    {{ pg_access_vip }}/16 dev eth0
  }
  track_script {
    chk_haproxy
  }
}
