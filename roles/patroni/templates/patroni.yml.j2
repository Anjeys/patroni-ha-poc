scope: patroni-cluster
namespace: /db/
name: "{{ inventory_hostname }}"

restapi:
  listen: "0.0.0.0:8008"
  connect_address: "{{ ansible_default_ipv4.address }}:8008"

etcd:
  host: "127.0.0.1:2379"

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: true
  initdb:
    - encoding: UTF8
    - data-checksums

postgresql:
  listen: "0.0.0.0:5432"
  connect_address: "{{ ansible_default_ipv4.address }}:5432"
  data_dir: "/var/lib/postgresql/14/main"
  bin_dir: "/usr/lib/postgresql/14/bin"
  pgpass: "/tmp/pgpass"
  authentication:
    replication:
      username: replicator
      password: rep_password
    superuser:
      username: postgres
      password: super_password
  parameters:
    max_connections: 100
    wal_level: replica
